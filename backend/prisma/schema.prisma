datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Bảng Users (Tài khoản và Phân quyền - Thành viên A)
model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String         @map("password_hash")
  fullName     String         @map("full_name")
  phone        String?
  role         String         // audience | organizer | gate_staff
  createdAt    DateTime       @default(now()) @map("created_at")
  
  concerts     Concert[]      // Các concert do organizer tạo
  orders       Order[]        // Các đơn hàng của user
  checkinLogs  CheckinLog[]   // Lịch sử check-in do gate_staff quét
  notifications Notification[]

  @@map("users")
}

// 2. Bảng Concerts (Quản lý Concert - Thành viên A)
model Concert {
  id            String          @id @default(uuid()) @db.Uuid
  organizerId   String          @map("organizer_id") @db.Uuid
  organizer     User            @relation(fields: [organizerId], references: [id])
  name          String
  venue         String
  startAt       DateTime        @map("start_at")
  saleOpenAt    DateTime        @map("sale_open_at")
  status        String          // draft | published | cancelled
  description   String?
  svgSeatingMap String?         @map("svg_seating_map")
  createdAt     DateTime        @default(now()) @map("created_at")
  
  ticketTypes   TicketType[]
  orders        Order[]
  artists       ConcertArtist[]
  vipGuests     VipGuest[]
  notifications Notification[]

  @@map("concerts")
}

// 3. Bảng Artists (Nghệ sĩ - Thành viên D)
model Artist {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  bioGenerated  String?         @map("bio_generated") // AI-generated from PDF press kit
  pdfSourceUrl  String?         @map("pdf_source_url")
  bioUpdatedAt  DateTime?       @map("bio_updated_at")
  
  concerts      ConcertArtist[]

  @@map("artists")
}

// 4. Bảng trung gian Concert - Artist (Nhiều - Nhiều)
model ConcertArtist {
  concertId String  @map("concert_id") @db.Uuid
  concert   Concert @relation(fields: [concertId], references: [id], onDelete: Cascade)
  artistId  String  @map("artist_id") @db.Uuid
  artist    Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([concertId, artistId])
  @@map("concert_artists")
}

// 5. Bảng Phân hạng vé (Thành viên B)
model TicketType {
  id            String      @id @default(uuid()) @db.Uuid
  concertId     String      @map("concert_id") @db.Uuid
  concert       Concert     @relation(fields: [concertId], references: [id], onDelete: Cascade)
  name          String      // GA | VIP | SVIP | CAT1 | CAT2
  price         Decimal     @db.Decimal(12, 2)
  totalQuantity Int         @map("total_quantity")
  maxPerAccount Int         @map("max_per_account") // Giới hạn vé tối đa mỗi tài khoản
  saleOpenAt    DateTime?   @map("sale_open_at")
  saleCloseAt   DateTime?   @map("sale_close_at")
  
  orderItems    OrderItem[]

  @@map("ticket_types")
}

// 6. Bảng Đơn đặt vé (Thành viên B)
model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  user           User        @relation(fields: [userId], references: [id])
  concertId      String      @map("concert_id") @db.Uuid
  concert        Concert     @relation(fields: [concertId], references: [id])
  status         String      // pending | paid | failed | refunded
  totalAmount    Decimal     @map("total_amount") @db.Decimal(12, 2)
  idempotencyKey String      @unique @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at")
  paidAt         DateTime?   @map("paid_at")
  
  orderItems     OrderItem[]

  @@map("orders")
}

// 7. Chi tiết đơn đặt vé (Thành viên B)
model OrderItem {
  id           String     @id @default(uuid()) @db.Uuid
  orderId      String     @map("order_id") @db.Uuid
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String     @map("ticket_type_id") @db.Uuid
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  quantity     Int
  unitPrice    Decimal    @map("unit_price") @db.Decimal(12, 2)
  
  tickets      Ticket[]

  @@map("order_items")
}

// 8. Bảng Vé (Thành viên B)
model Ticket {
  id          String       @id @default(uuid()) @db.Uuid
  orderItemId String       @map("order_item_id") @db.Uuid
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  userId      String       @map("user_id") @db.Uuid
  qrCode      String       @unique @map("qr_code") // Mã QR dùng tại cổng
  status      String       // valid | used | cancelled
  issuedAt    DateTime     @default(now()) @map("issued_at")
  usedAt      DateTime?    @map("used_at")
  
  checkinLogs CheckinLog[]

  @@map("tickets")
}

// 9. Lịch sử Soát vé (Bạn - Thành viên C)
model CheckinLog {
  id             String    @id @default(uuid()) @db.Uuid
  ticketId       String    @map("ticket_id") @db.Uuid
  ticket         Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  gateStaffId    String    @map("gate_staff_id") @db.Uuid
  gateStaff      User      @relation(fields: [gateStaffId], references: [id])
  deviceId       String    @map("device_id")
  synced         Boolean   @default(false)
  scannedAtLocal DateTime  @map("scanned_at_local")
  syncedAt       DateTime? @map("synced_at")

  @@map("checkin_logs")
}

// 10. Khách mời VIP (Bạn & Thành viên D)
model VipGuest {
  id         String   @id @default(uuid()) @db.Uuid
  concertId  String   @map("concert_id") @db.Uuid
  concert    Concert  @relation(fields: [concertId], references: [id], onDelete: Cascade)
  fullName   String   @map("full_name")
  identifier String   // Email hoặc số điện thoại từ CSV
  zone       String   // GUEST_LIST
  csvBatchId String?  @map("csv_batch_id")
  importedAt DateTime @default(now()) @map("imported_at")

  @@map("vip_guests")
}

// 11. Bảng Thông báo (Bạn - Thành viên C)
model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id])
  concertId   String?   @map("concert_id") @db.Uuid
  concert     Concert?  @relation(fields: [concertId], references: [id])
  channel     String    // app | email | zalo | sms
  type        String    // purchase_confirm | reminder_24h
  status      String    // pending | sent | failed
  scheduledAt DateTime? @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")

  @@map("notifications")
}
