datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  AUDIENCE
  ORGANIZER
  CHECKIN_STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
  INACTIVE
}

enum ConcertStatus {
  DRAFT
  PUBLISHED
  ON_SALE
  SALE_CLOSED
  CANCELLED
  published
}

enum TicketTypeStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  pending
  paid
  failed
  expired
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum TicketStatus {
  valid
  used
  cancelled
  VALID
  USED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WhitelistConfigStatus {
  ACTIVE
  INACTIVE
}

enum NotificationStatus {
  pending
  sent
  failed
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  users                 User[]
  concerts              Concert[]
  whitelistEmailConfigs WhitelistEmailConfig[]
  sponsorEmails         SponsorEmail[]
  guestImportJobs       GuestImportJob[]

  @@map("organizations")
}

model User {
  id             String        @id @default(uuid()) @db.Uuid
  email          String        @unique
  passwordHash   String        @map("password_hash")
  fullName       String        @map("full_name")
  phone          String?
  role           UserRole
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  status         UserStatus    @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  concerts                Concert[]
  orders                  Order[]
  tickets                 Ticket[]
  checkinLogs             CheckinLog[]
  notifications           Notification[]
  refreshTokens           RefreshToken[]
  staffAssignments        StaffAssignment[] @relation("StaffAssignmentsForUser")
  createdStaffAssignments StaffAssignment[] @relation("StaffAssignmentsCreatedBy")
  auditLogs               AuditLog[]

  @@index([organizationId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Concert {
  id              String        @id @default(uuid()) @db.Uuid
  organizerId     String        @map("organizer_id") @db.Uuid
  organizer       User          @relation(fields: [organizerId], references: [id])
  organizationId  String?       @map("organization_id") @db.Uuid
  organization    Organization? @relation(fields: [organizationId], references: [id])
  name            String
  venue           String
  startAt         DateTime      @map("start_at")
  saleOpenAt      DateTime      @map("sale_open_at")
  status          ConcertStatus
  description     String?
  seatMapEnabled  Boolean       @default(false) @map("seat_map_enabled")
  svgSeatingMap   String?       @map("svg_seating_map")
  cancelledReason String?       @map("cancelled_reason")
  cancelledAt     DateTime?     @map("cancelled_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")
  eventCode       String        @unique @map("event_code")

  ticketTypes           TicketType[]
  orders                Order[]
  artists               ConcertArtist[]
  vipGuests             VipGuest[]
  notifications         Notification[]
  staffAssignments      StaffAssignment[]
  whitelistEmailConfigs WhitelistEmailConfig[]
  artistBios            ArtistBio[]
  importJobs            GuestImportJob[]

  @@index([organizationId])
  @@index([organizerId])
  @@index([status, startAt])
  @@index([startAt])
  @@map("concerts")
}

model Artist {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  bioGenerated String?   @map("bio_generated")
  pdfSourceUrl String?   @map("pdf_source_url")
  bioUpdatedAt DateTime? @map("bio_updated_at")

  concerts ConcertArtist[]

  @@map("artists")
}

model ConcertArtist {
  concertId String  @map("concert_id") @db.Uuid
  concert   Concert @relation(fields: [concertId], references: [id], onDelete: Cascade)
  artistId  String  @map("artist_id") @db.Uuid
  artist    Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([concertId, artistId])
  @@map("concert_artists")
}

model TicketType {
  id               String           @id @default(uuid()) @db.Uuid
  concertId        String           @map("concert_id") @db.Uuid
  concert          Concert          @relation(fields: [concertId], references: [id], onDelete: Cascade)
  name             String
  zoneCode         String           @map("zone_code")
  price            Decimal          @db.Decimal(12, 2)
  totalQuantity    Int              @map("total_quantity")
  maxPerAccount    Int              @map("max_per_account")
  saleOpenAt       DateTime?        @map("sale_open_at")
  saleCloseAt      DateTime?        @map("sale_close_at")
  status           TicketTypeStatus @default(ACTIVE)
  reservedQuantity Int              @default(0) @map("reserved_quantity")
  soldQuantity     Int              @default(0) @map("sold_quantity")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")

  orderItems OrderItem[]
  inventory  TicketInventory?

  @@unique([concertId, zoneCode])
  @@index([status])
  @@map("ticket_types")
}

model TicketInventory {
  ticketTypeId      String     @id @map("ticket_type_id") @db.Uuid
  ticketType        TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  totalQuantity     Int        @map("total_quantity")
  availableQuantity Int        @map("available_quantity")
  reservedQuantity  Int        @default(0) @map("reserved_quantity")
  soldQuantity      Int        @default(0) @map("sold_quantity")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@map("ticket_inventory")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  user           User        @relation(fields: [userId], references: [id])
  concertId      String      @map("concert_id") @db.Uuid
  concert        Concert     @relation(fields: [concertId], references: [id])
  status         OrderStatus
  totalAmount    Decimal     @map("total_amount") @db.Decimal(12, 2)
  idempotencyKey String      @unique @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at")
  paidAt         DateTime?   @map("paid_at")

  orderItems OrderItem[]
  payments   Payment[]

  @@index([userId, createdAt])
  @@index([concertId, status])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String     @id @default(uuid()) @db.Uuid
  orderId      String     @map("order_id") @db.Uuid
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId String     @map("ticket_type_id") @db.Uuid
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  quantity     Int
  unitPrice    Decimal    @map("unit_price") @db.Decimal(12, 2)

  tickets Ticket[]

  @@index([orderId])
  @@index([ticketTypeId])
  @@map("order_items")
}

model Ticket {
  id          String       @id @default(uuid()) @db.Uuid
  orderItemId String       @map("order_item_id") @db.Uuid
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  userId      String       @map("user_id") @db.Uuid
  user        User         @relation(fields: [userId], references: [id])
  seatNumber  String?      @map("seat_number")
  qrCode      String       @unique @map("qr_code")
  status      TicketStatus
  issuedAt    DateTime     @default(now()) @map("issued_at")
  usedAt      DateTime?    @map("used_at")

  checkinLogs CheckinLog[]

  @@index([orderItemId])
  @@index([userId])
  @@index([status])
  @@map("tickets")
}

model CheckinLog {
  id             String    @id @default(uuid()) @db.Uuid
  ticketId       String    @map("ticket_id") @db.Uuid
  ticket         Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  gateStaffId    String    @map("gate_staff_id") @db.Uuid
  gateStaff      User      @relation(fields: [gateStaffId], references: [id])
  deviceId       String    @map("device_id")
  synced         Boolean   @default(false)
  scannedAtLocal DateTime  @map("scanned_at_local")
  syncedAt       DateTime? @map("synced_at")

  @@index([ticketId])
  @@index([gateStaffId])
  @@index([syncedAt])
  @@map("checkin_logs")
}

model VipGuest {
  id             String          @id @default(uuid()) @db.Uuid
  concertId      String          @map("concert_id") @db.Uuid
  concert        Concert         @relation(fields: [concertId], references: [id], onDelete: Cascade)
  fullName       String          @map("full_name")
  identifier     String?
  zone           String          @default("VIP")
  csvBatchId     String?         @map("csv_batch_id")
  importedAt     DateTime        @default(now()) @map("imported_at")
  email          String?
  phone          String?
  company        String?
  note           String?
  sourceImportId String?         @map("source_import_id") @db.Uuid
  sourceImport   GuestImportJob? @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)
  qrToken        String?         @unique @map("qr_token")
  ticketStatus   VipGuestStatus  @default(VALID) @map("ticket_status")
  emailStatus    EmailStatus     @default(PENDING) @map("email_status")
  emailError     String?         @map("email_error") @db.Text
  checkedInAt    DateTime?       @map("checked_in_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([concertId, email])
  @@unique([concertId, phone])
  @@index([concertId])
  @@map("vip_guests")
}

enum VipGuestStatus {
  VALID
  USED
  CANCELLED
}

enum EmailStatus {
  PENDING
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model ArtistBio {
  id                 String          @id @default(uuid()) @db.Uuid
  concertId          String          @map("concert_id") @db.Uuid
  concert            Concert         @relation(fields: [concertId], references: [id], onDelete: Cascade)
  sourcePdfObjectKey String          @map("source_pdf_object_key")
  sourcePdfFileName  String?         @map("source_pdf_file_name")
  status             ArtistBioStatus @default(UPLOADED)
  rawText            String?         @map("raw_text") @db.Text
  cleanedText        String?         @map("cleaned_text") @db.Text
  generatedBio       String?         @map("generated_bio") @db.Text
  reviewedBio        String?         @map("reviewed_bio") @db.Text
  publishedBio       String?         @map("published_bio") @db.Text
  errorMessage       String?         @map("error_message") @db.Text
  createdBy          String?         @map("created_by")
  reviewedBy         String?         @map("reviewed_by")
  publishedAt        DateTime?       @map("published_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([concertId, status])
  @@map("artist_bios")
}

enum ArtistBioStatus {
  UPLOADED
  PROCESSING
  AI_GENERATED
  APPROVED
  PUBLISHED
  FAILED
}

model SponsorEmail {
  id                String        @id @default(uuid()) @db.Uuid
  email             String        @unique
  organizationId    String?       @map("organization_id") @db.Uuid
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayName       String?       @map("display_name")
  isActive          Boolean       @default(true) @map("is_active")
  allowedEventCodes String[]      @default([]) @map("allowed_event_codes")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("sponsor_emails")
}

model GuestImportJob {
  id               String                @id @default(uuid()) @db.Uuid
  concertId        String?               @map("concert_id") @db.Uuid
  concert          Concert?              @relation(fields: [concertId], references: [id], onDelete: SetNull)
  organizationId   String?               @map("organization_id") @db.Uuid
  organization     Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  status           GuestImportStatus     @default(PENDING)
  senderEmail      String?               @map("sender_email")
  mailboxMessageId String?               @map("mailbox_message_id")
  originalFileName String?               @map("original_file_name")
  objectKey        String?               @map("object_key")
  totalRows        Int                   @default(0) @map("total_rows")
  successRows      Int                   @default(0) @map("success_rows")
  duplicateRows    Int                   @default(0) @map("duplicate_rows")
  errorRows        Int                   @default(0) @map("error_rows")
  emailSentRows    Int                   @default(0) @map("email_sent_rows")
  errorMessage     String?               @map("error_message") @db.Text
  startedAt        DateTime?             @map("started_at")
  finishedAt       DateTime?             @map("finished_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  rowErrors        GuestImportRowError[]
  vipGuests        VipGuest[]

  @@index([organizationId])
  @@index([status, createdAt])
  @@map("guest_import_jobs")
}

enum GuestImportStatus {
  PENDING
  PROCESSING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
  NO_FILE
}

model GuestImportRowError {
  id               String         @id @default(uuid()) @db.Uuid
  guestImportJobId String         @map("guest_import_job_id") @db.Uuid
  guestImportJob   GuestImportJob @relation(fields: [guestImportJobId], references: [id], onDelete: Cascade)
  rowNumber        Int            @map("row_number")
  rawData          Json?          @map("raw_data")
  errorCode        String         @map("error_code")
  message          String
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([guestImportJobId])
  @@map("guest_import_row_errors")
}

model StaffAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  staff     User     @relation("StaffAssignmentsForUser", fields: [staffId], references: [id], onDelete: Cascade)
  concertId String   @map("concert_id") @db.Uuid
  concert   Concert  @relation(fields: [concertId], references: [id], onDelete: Cascade)
  gateId    String   @map("gate_id")
  createdBy String   @map("created_by") @db.Uuid
  creator   User     @relation("StaffAssignmentsCreatedBy", fields: [createdBy], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([staffId, concertId, gateId])
  @@index([concertId])
  @@map("staff_assignments")
}

model WhitelistEmailConfig {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  concertId          String?               @map("concert_id") @db.Uuid
  concert            Concert?              @relation(fields: [concertId], references: [id], onDelete: Cascade)
  mailboxAddress     String                @map("mailbox_address")
  allowedSenderEmail String                @map("allowed_sender_email")
  subjectKeyword     String                @map("subject_keyword")
  status             WhitelistConfigStatus @default(ACTIVE)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([concertId])
  @@index([status])
  @@map("whitelist_email_configs")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole    String   @map("actor_role")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  user        User               @relation(fields: [userId], references: [id])
  concertId   String?            @map("concert_id") @db.Uuid
  concert     Concert?           @relation(fields: [concertId], references: [id])
  channel     String
  type        String
  status      NotificationStatus
  scheduledAt DateTime?          @map("scheduled_at")
  sentAt      DateTime?          @map("sent_at")

  @@index([userId])
  @@index([concertId])
  @@index([status, scheduledAt])
  @@map("notifications")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentGateway String        @map("payment_gateway")
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  transactionId  String?       @map("transaction_id")
  responseCode   String?       @map("response_code")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([status, createdAt])
  @@map("payments")
}
