DATABASE_URL="postgresql://postgres:password123@localhost:5434/ticketbox?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000
QR_SECRET_KEY="change-me-in-dev"

# MinIO / S3-compatible object storage
MINIO_ENDPOINT="http://localhost:9000"
MINIO_REGION="us-east-1"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_FORCE_PATH_STYLE="true"
ARTIST_BIO_BUCKET="artist-bio-source"
VIP_GUEST_IMPORT_BUCKET="vip-guest-imports"
TICKET_ASSET_BUCKET="ticket-assets"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"

# IMAP mailbox used for sponsor CSV imports
IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_MAILBOX="INBOX"
VIP_GUEST_IMPORT_CRON="0 1 * * *"

# SMTP used for e-ticket and import notifications
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TicketBox <no-reply@ticketbox.local>"

