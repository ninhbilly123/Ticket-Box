# System Configuration
PORT=3000
DATABASE_URL="postgresql://postgres:password123@localhost:5433/ticketbox?schema=public"
CORS_ORIGIN="http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002"

# Redis Cache, Locks & Idempotency Configuration
REDIS_URL="redis://localhost:6379"
QR_SECRET_KEY="replace-with-a-random-secret-at-least-32-characters-long"
REDIS_OPERATION_TIMEOUT_MS=500
CONCERT_LIST_CACHE_TTL=60
CONCERT_DETAIL_CACHE_TTL=120
CONCERT_AVAILABILITY_CACHE_TTL=5

# Rate Limits Configuration
CONCERT_LIST_RATE_LIMIT_PER_MINUTE=120
CONCERT_LIST_RATE_LIMIT_PER_USER_PER_MINUTE=300
CONCERT_DETAIL_RATE_LIMIT_PER_MINUTE=120
CONCERT_AVAILABILITY_RATE_LIMIT_PER_MINUTE=60
HOLD_ORDER_USER_RATE_LIMIT=5
HOLD_ORDER_IP_RATE_LIMIT=20
HOLD_ORDER_RATE_LIMIT_WINDOW_SECONDS=60

# JWT Authentication Security
JWT_SECRET="your-jwt-secret-key-here"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_DAYS=7

# Order Booking & Ticket Expiration settings
ORDER_HOLD_TTL_SECONDS=600
CHECKOUT_TOKEN_TTL_SECONDS=300
WAITING_ROOM_ENABLED_CONCERT_IDS=""
WAITING_ROOM_RELEASE_PER_MINUTE=500

# RabbitMQ Messaging Queue Configuration
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_EXCHANGE="ticketbox.events"
CONCERT_LIST_CACHE_INVALIDATION_QUEUE="concert-listing-cache-invalidation"
ORDER_EXPIRE_DELAY_QUEUE="orders.expire.delay.queue"
ORDER_EXPIRE_QUEUE="orders.expire.queue"
ORDER_EXPIRE_DLX="orders.expire.dlx"
ORDER_EXPIRE_ROUTING_KEY="orders.expire"

# VNPAY Sandbox Gateway Configuration (Task B)
VNPAY_TMN_CODE="your_vnpay_tmn_code_here"
VNPAY_HASH_SECRET="your_vnpay_hash_secret_here"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/api/v1/payments/vnpay-return"

# Local-only mock payment webhook. Keep disabled outside explicit tests.
ENABLE_MOCK_PAYMENT_WEBHOOK="false"
MOCK_PAYMENT_WEBHOOK_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# SMTP Email Configuration (Task B & Notification Worker)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false" # set to "true" for port 465 (SSL), "false" for port 587 (TLS/STARTTLS)
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_gmail_app_password_here"
SMTP_FROM="TicketBox <your_email@gmail.com>"

# MinIO / S3-compatible Object Storage
MINIO_ENDPOINT="http://localhost:9000"
MINIO_REGION="us-east-1"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_FORCE_PATH_STYLE="true"
ARTIST_BIO_BUCKET="artist-bio-source"
VIP_GUEST_IMPORT_BUCKET="vip-guest-imports"
TICKET_ASSET_BUCKET="ticket-assets"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"

# Sponsor Mailbox for VIP CSV Imports
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_MAILBOX="INBOX"
VIP_GUEST_IMPORT_CRON="0 1 * * *"

# Ngrok Configuration (Optional, for VNPAY Webhook IPN local testing)
NGROK_AUTHTOKEN="your_ngrok_token_here"
