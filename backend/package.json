{
  "name": "ticketbox-backend",
  "version": "1.0.0",
  "description": "TicketBox Express Backend API",
  "main": "src/app.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test:member-a": "ts-node --files src/scripts/memberA.smoke.ts",
    "test:concurrency": "ts-node --files tests/concurrency-test.ts",
    "test:user-limit": "ts-node --files tests/user-limit-test.ts",
    "test:user-limit-concurrency": "ts-node --files tests/user-limit-concurrency-test.ts",
    "test:rate-limit": "ts-node --files tests/rate-limit-test.ts",
    "test:idempotency": "ts-node --files tests/idempotency-test.ts",
    "test:reminder": "ts-node --files tests/reminder-test.ts",
    "test:payment-qr": "ts-node --files tests/payment-qr-test.ts",
    "test:waiting-room-80k": "ts-node --files tests/waiting-room-80k-test.ts",
    "test:waiting-room-80k-plus-1": "ts-node --files tests/waiting-room-80k-plus-1-test.ts",
    "test:circuit-breaker": "ts-node --files tests/circuit-breaker-test.ts",
    "test:autocannon": "ts-node --files tests/autocannon-load-test.ts",
    "test:e2e-features": "ts-node --files tests/e2e-features-smoke-test.ts",
    "db:clean-test": "ts-node --files src/scripts/clean-test-data.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.840.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.15.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.56.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "imapflow": "^1.0.181",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.7.4",
    "multer": "^2.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "redis": "^4.6.14",
    "sanitize-html": "^2.17.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.5",
    "@types/sanitize-html": "^2.16.1",
    "autocannon": "^8.0.0",
    "prisma": "^5.15.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "overrides": {
    "bullmq": {
      "redis": "$redis"
    }
  }
}
